{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "321d8756a542423c98f34a23871929b4",
    "m_Title": "Main Tex: read this before the groups",
    "m_Content": "This is the shared Main Tex sample. The same texture is sampled again inside MainColor, Dissolve, Outline, Secondary Color and Alpha, always with the distorted UV coming from the Distortion group and the same Sampler State.\n\nWhich channel goes where:\n  R -> MainColor (the coloured shape)\n  G -> Dissolve, Dissolve Edge, Outline (the pattern that erodes)\n  B -> Secondary Color (mask for the 2nd tint)\n  A -> Alpha (the silhouette)\n\nSo if the shape looks wrong, check which channel of your texture you painted. A texture that only has an alpha channel will give you a shape with no dissolve pattern and no secondary colour.",
    "m_TextSize": 1,
    "m_Theme": 7,
    "m_Position": {
        "serializedVersion": "2",
        "x": -347.0,
        "y": -989.0,
        "width": 654.0,
        "height": 623.6019287109375
    },
    "m_Group": {
        "m_Id": "38c5048619f54b708cd4fda5ae85a880"
    }
}

