{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "aa4b31cb19f240808ac2fd7ffa0f5856",
    "m_Title": "Dissolve Sharpness: reads the per particle dissolve values",
    "m_Content": "This group has no maths, it just splits UV1 (Custom1) and hands the values to the two Dissolve Function nodes.\n\n  UV1.y -> Dissolve Amount for the Dissolve Edge copy\n  UV1.z -> Falloff for BOTH dissolve functions\n\nFalloff is the width of the transition band:\n  near 0   = hard, crisp burn line\n  higher   = soft, misty fade\n\nThe name is a little misleading: it carries the amount as well as the sharpness.",
    "m_TextSize": 1,
    "m_Theme": 6,
    "m_Position": {
        "serializedVersion": "2",
        "x": 764.0,
        "y": -508.0,
        "width": 655.0,
        "height": 502.0
    },
    "m_Group": {
        "m_Id": "6fa6099d71fe46b883c738eb38d08b45"
    }
}

