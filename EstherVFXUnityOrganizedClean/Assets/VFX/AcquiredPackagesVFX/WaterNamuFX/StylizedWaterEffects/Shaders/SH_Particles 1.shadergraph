{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4f5bf756d9674630a1d0d60f423eae83",
    "m_Title": "MainColor: the base colour",
    "m_Content": "WHAT IT DOES\nBuilds the coloured shape of the particle.\n\nHOW IT WORKS\n1. Vertex Colour RGB (the particle Start Color) x Main Tex R. That gives a tinted shape.\n2. A Lerp blends that with the Secondary Colour. The blend amount comes from the Secondary Color group.\n3. The result is multiplied by Intensity.\n\nThe output does not go straight to Base Color. It travels into the Dissolve Edge group, where the dissolve mask cuts it and the rim colour is added on top.",
    "m_TextSize": 1,
    "m_Theme": 2,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1080.0,
        "y": -1377.0,
        "width": 1096.0,
        "height": 399.0
    },
    "m_Group": {
        "m_Id": "ea4408970a2b46918f775951c39ac642"
    }
}

