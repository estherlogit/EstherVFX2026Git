{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d93bac4b31f443e3aaaaad7419a7a38e",
    "m_Title": "Dissolve Edge: the glowing burn rim",
    "m_Content": "WHAT IT DOES\nDraws a bright rim exactly on the dissolve boundary, like burning paper, and cuts the main colour with the dissolve.\n\nHOW IT WORKS\n1. Main Tex G minus (OutlineThickness x 0.1). Lowering the pattern makes it dissolve slightly earlier, so this is a shrunken copy of the shape.\n2. That shrunken pattern goes through a second Dissolve Function, with the same amount and falloff.\n3. Big mask (from the Dissolve group) minus small mask = a thin band that sits right on the edge. Band x OutlineColor = the rim.\n4. The main colour is multiplied by the small mask, so the body is cut by the dissolve too.\n5. Body + rim are added and passed to the Outline group.\n\nOutlineThickness controls how wide this burn rim is.",
    "m_TextSize": 1,
    "m_Theme": 5,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1858.0,
        "y": 570.0,
        "width": 1670.0,
        "height": 392.0
    },
    "m_Group": {
        "m_Id": "70cfbffab46d48e9852f7ef8c42cd216"
    }
}

